# URL base do motoristas-service. Sem gateway pronto ainda, aponta direto
# para o serviço (ver documento "Adendo: Decomposição em Microsserviços").
VITE_API_BASE_URL=http://localhost:8080

# URL base do manifesto-service (importação de manifesto em CSV). Serviço
# separado, em outra porta — ver README do manifesto-service.
VITE_MANIFESTO_SERVICE_URL=http://localhost:8081

# URL base do auth-service (login e usuários). Ver README do newelog-auth-service.
VITE_AUTH_SERVICE_URL=http://localhost:8082

# URL base do ranking-service (ranking mensal da frota). Ver README do newelog-ranking-service.
VITE_RANKING_SERVICE_URL=http://localhost:8083

# Opcional, só em desenvolvimento: "1" faz a tela de ranking usar dados simulados
# (src/api/ranking.mock.ts) em vez de chamar o ranking-service.
# VITE_RANKING_MOCK=1
